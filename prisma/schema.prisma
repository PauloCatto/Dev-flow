generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("Developer")
  createdAt    DateTime @default(now())
}

model Project {
  id             String   @id @default(cuid())
  userId         String   @default("user-demo-paulo")
  name           String
  description    String
  key            String
  lead           String
  tasksCount     Int      @default(0)
  completedTasks Int      @default(0)
  status         String   @default("Ativo")
  updatedAt      String   @default("Agora mesmo")
  createdAt      DateTime @default(now())
  tasks          Task[]
}

model Task {
  id           String   @id @default(cuid())
  userId       String   @default("user-demo-paulo")
  projectId    String
  title        String
  description  String?
  status       String   @default("todo")
  priority     String   @default("media")
  assigneeName String   @default("Paulo Developer")
  dueDate      String?  @default("Sem prazo")
  createdAt    String   @default("Hoje")
  createdDate  DateTime @default(now())
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
